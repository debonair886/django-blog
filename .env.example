# 复制成 .env（或直接在 Railway 的 Variables 里填）后再使用，.env 本身不会提交。

# 生产环境必须换成一串随机值：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 本地开发填 1，线上填 0
DJANGO_DEBUG=1

# Railway 会自动注入 RAILWAY_PUBLIC_DOMAIN，通常不用手填；
# 用自定义域名时在这里加：a.com,b.com
DJANGO_ALLOWED_HOSTS=

# 部署时由 Railway 的 PostgreSQL 插件自动注入（postgresql://user:pass@host:port/db）
# 本地留空即使用 sqlite3
DATABASE_URL=

# 走 HTTPS 时保持 1；本地用 http 调试可以临时设成 0
DJANGO_SECURE_COOKIES=1
